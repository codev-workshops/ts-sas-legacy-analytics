+test "aggregate over a CALCULATED non-aggregate alias folds the alias per row (BUG-sqlaggcalcarg)" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var diags = diag.Diagnostics.init(a);
+    var lib = Library.init(a);
+
+    const d = try a.create(Dataset);
+    d.* = Dataset.init(a, "d");
+    _ = try d.addColumn("g", .char);
+    _ = try d.addColumn("bal", .num);
+    for ([_]struct { g: []const u8, bal: f64 }{
+        .{ .g = "A", .bal = 100 }, .{ .g = "A", .bal = 200 }, .{ .g = "B", .bal = 50 },
+    }) |r| try d.appendRow(&.{ .{ .str = r.g }, .{ .num = r.bal } });
+    try lib.put("d", d);
+
+    // a CASE alias inside sum(): A → 300*0.5 = 150, B → 50*1 = 50 (was: missing)
+    try runSql(a, &lib, &diags,
+        \\proc sql; create table r as
+        \\ select g, case when g='A' then 0.5 else 1.0 end as rw,
+        \\        sum(bal) as tot, sum(bal * calculated rw) as rwa
+        \\ from d group by 1, 2 order by g; quit;
+    );
+    const r = lib.find("r").?;
+    try t.expectEqual(@as(usize, 2), r.rowCount());
+    try t.expectEqual(@as(f64, 150), r.row(0)[3].num);
+    try t.expectEqual(@as(f64, 50), r.row(1)[3].num);
+
+    // an arithmetic alias inside sum(): A → (100*2)+(200*2) = 600; dbl is not a
+    // group key, so the result remerges to one row per input row
+    try runSql(a, &lib, &diags,
+        \\proc sql; create table s as
+        \\ select g, bal * 2 as dbl, sum(calculated dbl) as sdbl
+        \\ from d group by g order by g; quit;
+    );
+    const s = lib.find("s").?;
+    try t.expectEqual(@as(usize, 3), s.rowCount());
+    try t.expectEqual(@as(f64, 600), s.row(0)[2].num);
+    try t.expectEqual(@as(f64, 600), s.row(1)[2].num);
+    try t.expectEqual(@as(f64, 100), s.row(2)[2].num);
+
