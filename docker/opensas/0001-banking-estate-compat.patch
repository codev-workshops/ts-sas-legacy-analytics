+fn findAliasItem(items: []const Item, alias: []const u8) ?Item {
+    var found: ?Item = null;
+    for (items) |it| {
+        if (it.alias) |a| if (eqi(a, alias)) {
+            found = it;
+        };
+    }
+    if (found) |it| if (!it.is_star) return it;
+    return null;
