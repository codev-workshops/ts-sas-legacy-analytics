+const OnSubqResolved = struct { ds: *Dataset, hidden: usize };
+
+/// Evaluate every `(select …)` in `step.on` once per row of `t2` and store the
+/// value in a hidden trailing column `_sq<k>_` of a copy of `t2`; rewrite the
+/// ON to reference `<t2q>._sq<k>_` instead. Only subqueries correlated to the
+/// joined-in table (or uncorrelated) are supported — one that reads the LEFT
+/// side would need per-pair evaluation and fails loud.
+fn resolveOnSubqueries(arena: std.mem.Allocator, lib: *Library, diags: *diag.Diagnostics, acc: *Dataset, t2: *Dataset, step: *JoinStep) diag.Error!?OnSubqResolved {
+    const ot = step.on.?;
+    const t2q = step.alias orelse step.table;
+    const t2x = try arena.create(Dataset);
+    t2x.* = Dataset.init(arena, t2.name);
+    for (t2.columns.items) |c| _ = try t2x.addColumnLike(c.name, c);
+    var cells_per_row: std.ArrayList(std.ArrayList(Value)) = .empty;
+    for (t2.rows.items) |r| {
+        var cells: std.ArrayList(Value) = .empty;
+        try cells.appendSlice(arena, r);
+        try cells_per_row.append(arena, cells);
+    }
+    var on_out: std.ArrayList(Token) = .empty;
+    var k: usize = 0;
+    var i: usize = 0;
+    while (i < ot.len) {
+        if (!(ot[i].tag == .lparen and atKw(ot, i + 1, "select"))) {
+            try on_out.append(arena, ot[i]);
+            i += 1;
+            continue;
+        }
+        var depth: usize = 1;
+        var j = i + 1;
+        while (j < ot.len) : (j += 1) {
+            if (ot[j].tag == .lparen) depth += 1 else if (ot[j].tag == .rparen) {
+                depth -= 1;
+                if (depth == 0) break;
+            }
+        }
+        const sub = ot[i .. j + 1];
+        // A reference to a LEFT-side qualified column inside the subquery
+        // would need one subquery run per (left,right) pair — not supported.
+        for (ot[i + 1 .. j]) |tk| {
+            if (tk.tag != .name) continue;
+            const d = std.mem.indexOfScalar(u8, tk.text, '.') orelse continue;
+            if (eqi(tk.text[0..d], t2q)) continue;
+            if (acc.indexOf(tk.text) != null) {
+                unsupported("PROC SQL: JOIN ON subquery references the left side of the join");
+                return null;
+            }
+        }
+        const colname = try std.fmt.allocPrint(arena, "_sq{d}_", .{k});
+        k += 1;
+        var ty: ?VarType = null;
+        for (t2.rows.items, 0..) |_, ri| {
+            const lit = try substituteSubqueries(arena, lib, diags, sub, .{ .ds = t2, .ri = ri, .table = step.table, .alias = step.alias });
+            if (lit.len != 1) return diags.fail(error.ParseError, ot[i].line, "PROC SQL: JOIN ON subquery did not reduce to a scalar", .{});
+            const v: Value = switch (lit[0].tag) {
+                .dot => Value.missing,
+                .number => .{ .num = sasParseFloat(lit[0].text) orelse std.math.nan(f64) },
+                .string => .{ .str = lit[0].text },
+                else => return diags.fail(error.ParseError, ot[i].line, "PROC SQL: JOIN ON subquery did not reduce to a scalar", .{}),
+            };
+            if (ty == null and lit[0].tag != .dot) ty = if (v == .str) .char else .num;
+            try cells_per_row.items[ri].append(arena, v);
+        }
+        _ = try t2x.addColumn(colname, ty orelse .num);
+        try on_out.append(arena, .{ .tag = .name, .text = try std.fmt.allocPrint(arena, "{s}.{s}", .{ t2q, colname }), .line = ot[i].line });
+        i = j + 1;
+    }
+    for (cells_per_row.items) |cells| try t2x.rows.append(arena, cells.items);
+    step.on = on_out.items;
+    return .{ .ds = t2x, .hidden = k };
+}
+
+/// Project `ds` without its last `n` columns (the hidden `_sq<k>_` helpers).
+fn dropTrailingColumns(arena: std.mem.Allocator, ds: *Dataset, n: usize) !*Dataset {
+    const keep = ds.columns.items.len - n;
+    const out = try arena.create(Dataset);
+    out.* = Dataset.init(arena, ds.name);
+    for (ds.columns.items[0..keep]) |c| _ = try out.addColumnLike(c.name, c);
+    for (ds.rows.items) |r| try out.rows.append(arena, r[0..keep]);
+    return out;
+}
