-            break;
+            break :outer;
         }
-    }
+    };
     if (text == null) return false; // no file in any casing → caller warn-skips
     // Compile into a scratch buffer (discarded): the side effect is the macro
     // definition landing in st.macros. process() only surfaces allocator errors,
@@ -1442,9 +1506,11 @@ fn upperDup(a: std.mem.Allocator, s: []const u8) Error![]const u8 {
 /// `%include "file" [/options];` — splice the included file's source at this site
 /// (recursively processed, so its own `%include`/macros/`&vars` resolve in the
 /// same scope). Options such as `/nosource` are accepted and ignored. A path is a
-/// quoted "file"/'file' or a bare token; a missing file is a loud ERROR (SAS 9.4
-/// treats a missing include as a hard failure — dropping the code it was meant to
-/// contribute is silent-wrong). The include path resolves against the CWD.
+/// quoted "file"/'file' or a bare token, with `&var` references resolved (the
+/// `%include "&root/lib/x.sas"` idiom — GAP-includemacrovar); a missing file is a
+/// loud ERROR (SAS 9.4 treats a missing include as a hard failure — dropping the
+/// code it was meant to contribute is silent-wrong). The include path resolves
+/// against the CWD.
 fn handleInclude(st: *State, src: []const u8, from: usize, out: *std.ArrayList(u8)) Error!usize {
     var k = skipWs(src, from);
     var path: []const u8 = "";
@@ -1453,12 +1519,12 @@ fn handleInclude(st: *State, src: []const u8, from: usize, out: *std.ArrayList(u
         k += 1;
         const ps = k;
         while (k < src.len and src[k] != q) k += 1;
-        path = src[ps..k];
+        path = if (q == '"') try resolveText(st, src[ps..k]) else src[ps..k];
         if (k < src.len) k += 1; // closing quote
     } else {
         const ps = k;
         while (k < src.len and src[k] != ';' and src[k] != '/' and !std.ascii.isWhitespace(src[k])) k += 1;
-        path = src[ps..k];
+        path = try resolveText(st, src[ps..k]);
     }
     // swallow any trailing options (`/nosource`, `/source2`, …) up to the `;`
     while (k < src.len and src[k] != ';') k += 1;
@@ -1629,7 +1695,10 @@ fn handleLet(st: *State, src: []const u8, from: usize) Error!usize {
         if (st.macro_call_depth > 0) st.returning = true;
         return if (k < src.len) k + 1 else k;
     }
-    const val = try resolveText(st, std.mem.trim(u8, src[vs..k], " \t\r\n"));
+    // SAS strips leading/trailing blanks from the value AFTER resolution too:
+    // a function-style macro whose body starts on the line after `%macro m;`
+    // yields "\n  7" and `%let n=%m;` must store "7", not a newline-led value.
+    const val = std.mem.trim(u8, try resolveText(st, std.mem.trim(u8, src[vs..k], " \t\r\n")), " \t\r\n");
     // BUG-macrobareletscope: a bare %let of a BRAND-NEW name inside a macro is
     // LOCAL to that invocation in SAS 9.4 (was leaking to global). A name any
     // active scope already owns (findLocal — %local/param/earlier auto-local,
@@ -2841,7 +2910,19 @@ fn handleSysfunc(st: *State, src: []const u8, from: usize, out: *std.ArrayList(u
     // %QSYSFUNC quotes its RESULT (F2): mask every &/% (and comma) so a later
     // reference can't re-resolve them — mirrors the Q-form macro fns (%qscan/…).
     // Plain %sysfunc returns the result unmasked (SAS does not quote it).
-    try out.appendSlice(st.a, if (quote) try maskTriggers(st.a, result) else result);
+    // Edge blanks of the RESULT are the exception: SAS keeps them through %LET
+    // (`%let d=%sysfunc(putn(&x,dollar12.2))` famously carries its leading
+    // blanks — hence the -L / %left idiom), while %LET strips the blanks of
+    // ordinary expanded text. Mask them so the %LET trim leaves them alone.
+    const body = if (quote) try maskTriggers(st.a, result) else result;
+    const lead = body.len - std.mem.trimStart(u8, body, " ").len;
+    const trail = if (lead == body.len) 0 else body.len - std.mem.trimEnd(u8, body, " ").len;
+    if (lead + trail > 0) {
+        const masked = try st.a.dupe(u8, body);
+        @memset(masked[0..lead], mask_blank);
+        @memset(masked[body.len - trail ..], mask_blank);
+        try out.appendSlice(st.a, masked);
+    } else try out.appendSlice(st.a, body);
     return pa.end;
 }
 
@@ -6834,3 +6915,43 @@ test "BUG-sysfuncmissingdot: %sysfunc maps bare `.`/`.A`–`.Z` to numeric missi
     try std.testing.expectEqualStrings("4", try expand(a, "%sysfunc(sum(1,.,3))", &d4));
     try std.testing.expectEqualStrings("", try d4.render());
 }
+
+test "GAP-optsasautos: OPTIONS SASAUTOS=(\"dir\" SASAUTOS) sets the autocall search list; &var in the path and in %include resolve" {
+    setAutocallDir(null);
