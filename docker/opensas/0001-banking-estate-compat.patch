-/// Autocall (SASAUTOS) directory: when an invoked macro is undefined, look for
-/// `<dir>/<name>.sas` (case-insensitively — real autocall libraries are mixed case),
-/// compile it (which defines the macro), and retry. Set once by the CLI from
-/// `--sasautos`/`$SASAUTOS`; null disables autocall (the warn-and-skip path).
-var g_sasautos: ?[]const u8 = null;
+/// Autocall (SASAUTOS) directories, searched in order: when an invoked macro is
+/// undefined, look for `<dir>/<name>.sas` (case-insensitively — real autocall
+/// libraries are mixed case), compile it (which defines the macro), and retry.
+/// Seeded by the CLI from `--sasautos`/`$SASAUTOS`; `OPTIONS SASAUTOS=(…)` in
+/// the program replaces the list (GAP-optsasautos), with the bare keyword
+/// `SASAUTOS` inside the list standing for the directories in force before the
+/// statement, exactly as SAS documents it. Empty disables autocall (the
+/// warn-and-skip path).
+var g_sasautos: []const []const u8 = &.{};
+var g_cli_sasautos: [1][]const u8 = undefined;
 pub fn setAutocallDir(dir: ?[]const u8) void {
-    g_sasautos = dir;
+    if (dir) |d| {
+        g_cli_sasautos[0] = d;
+        g_sasautos = g_cli_sasautos[0..];
+    } else g_sasautos = &.{};
+}
+
+/// `SASAUTOS=` value parser for applyOptionsStmt: `SASAUTOS="dir"`,
+/// `SASAUTOS=(“dir1” 'dir2' SASAUTOS)`. Quoted entries are directories (with
+/// `&var` references already resolved by the ordinary scan — the option text
+/// process() hands over is pre-resolution, so they are resolved here); the bare
+/// word SASAUTOS splices in the current list. Any other bare word is a fileref,
+/// which the macro layer cannot see → loud error, list left unchanged.
+fn parseSasautos(st: *State, text: []const u8, from: usize) Error!void {
+    var p = from;
+    while (p < text.len and (text[p] == ' ' or text[p] == '\t' or text[p] == '=')) p += 1;
+    const paren = p < text.len and text[p] == '(';
+    if (paren) p += 1;
+    var dirs: std.ArrayList([]const u8) = .empty;
+    while (p < text.len) {
+        while (p < text.len and std.ascii.isWhitespace(text[p])) p += 1;
+        if (p >= text.len) break;
+        const c = text[p];
+        if (c == ')') break;
+        if (c == '\'' or c == '"') {
+            p += 1;
+            const s = p;
+            while (p < text.len and text[p] != c) p += 1;
+            try dirs.append(st.a, try resolveText(st, text[s..p]));
+            if (p < text.len) p += 1;
+        } else if (isNameStart(c)) {
+            const s = p;
+            while (p < text.len and isNameChar(text[p])) p += 1;
+            const w = text[s..p];
+            if (!eqi(w, "sasautos")) {
+                try st.diags.macroErr(0, "SASAUTOS=: fileref {s} is not supported here — give the directory as a quoted path", .{w});
+                return;
+            }
+            try dirs.appendSlice(st.a, g_sasautos);
+        } else {
+            try st.diags.macroErr(0, "SASAUTOS=: unexpected '{c}' in the directory list", .{c});
+            return;
+        }
+        if (!paren) break; // unparenthesized form takes exactly one entry
+    }
+    g_sasautos = try dirs.toOwnedSlice(st.a);
 }
 
 /// Expand `src` into arena-owned text with all macro constructs resolved.
@@ -1064,7 +1113,7 @@ fn process(st: *State, src: []const u8, out: *std.ArrayList(u8)) Error!void {
                     while (e < src.len and src[e] != q) e += 1;
                 }
             }
-            applyOptionsStmt(st, src[i..e]);
+            try applyOptionsStmt(st, src[i..e]);
             // Do NOT consume the statement: it used to be copied to `out`
             // verbatim, which bypassed the ordinary scan — so an `&ref` in an
             // OPTIONS statement was never resolved (`%let v=nodate; options
@@ -1118,11 +1167,12 @@ fn stmtKw(src: []const u8, i: usize, word: []const u8) bool {
     return after >= src.len or !isNameChar(src[after]);
 }
 
-/// Scan an `OPTIONS …` statement body (sans `;`) for the macro-expression
