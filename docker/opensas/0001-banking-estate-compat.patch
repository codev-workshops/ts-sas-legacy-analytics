+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var diags = diag.Diagnostics.init(a);
+    // no list yet → %greet warn-skips; after OPTIONS it autocalls from tests/autocall;
+    // the bare SASAUTOS keyword keeps the previous list (here: nothing) — no error.
+    const out = try expand(a,
+        "%let root=tests;%greet(A) options mautosource sasautos=(\"&root/autocall\" SASAUTOS) mprint;%greet(B)", &diags);
+    try std.testing.expectEqualStrings(
+        " options mautosource sasautos=(\"tests/autocall\" SASAUTOS) mprint;data _null_;put \"Hello B\";run;",
+        out,
+    );
+    try std.testing.expectEqualStrings("WARNING: Apparent invocation of macro GREET not resolved.\n", try diags.render());
+    try std.testing.expectEqual(@as(usize, 1), g_sasautos.len);
+
+    // %include "&root/…" resolves the reference before opening the file
+    var d2 = diag.Diagnostics.init(a);
+    const inc = try expand(a, "%let root=tests;%include \"&root/autocall/greet.sas\";%greet(C)", &d2);
+    try std.testing.expectEqualStrings("", try d2.render());
+    try std.testing.expect(std.mem.indexOf(u8, inc, "Hello C") != null);
+
+    // a fileref in the list is beyond the macro layer → loud, list unchanged
+    var d3 = diag.Diagnostics.init(a);
+    _ = try expand(a, "options sasautos=(myref);", &d3);
+    try std.testing.expect(d3.hasErrors());
+    try std.testing.expectEqual(@as(usize, 1), g_sasautos.len);
+    // NOMAUTOSOURCE switches autocall off
+    var d4 = diag.Diagnostics.init(a);
+    _ = try expand(a, "options nomautosource;", &d4);
+    try std.testing.expectEqual(@as(usize, 0), g_sasautos.len);
+}
+
+test "BUG-lettrimexpanded: %let strips leading/trailing blanks AFTER resolution (function-style macro with a body-first newline)" {
