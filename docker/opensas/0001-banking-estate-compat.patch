+test "BUG-sqlrowwisehavingcalc: no-agg HAVING sees the row's SELECT aliases; CALCULATED inside a CASE arm resolves" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var lib = Library.init(a);
+    const d = try a.create(Dataset);
+    d.* = Dataset.init(a, "d");
+    _ = try d.addColumn("x", .num);
+    _ = try d.addColumn("y", .char);
+    try d.appendRow(&.{ numV(1), strV("a") });
+    try d.appendRow(&.{ numV(5), strV("b") });
+    try d.appendRow(&.{ numV(9), strV("c") });
+    try lib.put("d", d);
+    var diags = diag.Diagnostics.init(a);
+    try runSql(a, &lib, &diags,
+        \\proc sql; create table o as
+        \\ select x, y, x*2 as dbl,
+        \\   case when calculated dbl > 5 then 'BIG' else '' end as tag length=5
+        \\ from d having tag ne '' order by x desc; quit;
+    );
+    try t.expect(!diags.hasErrors());
+    const o = lib.find("o").?;
+    // rows x=5 (dbl 10) and x=9 (dbl 18) carry tag BIG; x=1 is filtered out
+    try t.expectEqual(@as(usize, 2), o.rows.items.len);
+    try t.expectEqual(@as(f64, 9), o.row(0)[0].num);
+    try t.expectEqual(@as(f64, 5), o.row(1)[0].num);
+    try t.expectEqualStrings("BIG", o.row(0)[o.indexOf("tag").?].str);
+    // a HAVING directly after a JOIN … ON must end the ON clause, not be swallowed by it
+    const s = try a.create(Dataset);
+    s.* = Dataset.init(a, "s");
+    _ = try s.addColumn("x", .num);
+    _ = try s.addColumn("m", .num);
+    try s.appendRow(&.{ numV(1), numV(100) });
+    try s.appendRow(&.{ numV(5), numV(200) });
+    try lib.put("s", s);
+    var diags2 = diag.Diagnostics.init(a);
+    try runSql(a, &lib, &diags2,
+        \\proc sql; create table o2 as
+        \\ select e.*, s.m, case when e.x > 4 then 'BIG' else '' end as tag length=5
+        \\ from d e left join s on e.x = s.x
+        \\ having tag ne ''; quit;
+    );
+    try t.expect(!diags2.hasErrors());
+    const o2 = lib.find("o2").?;
+    try t.expectEqual(@as(usize, 2), o2.rows.items.len);
+    try t.expectEqual(@as(f64, 200), o2.row(0)[o2.indexOf("m").?].num);
+    try t.expect(o2.row(1)[o2.indexOf("m").?].isMissing());
+}
